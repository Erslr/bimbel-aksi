<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content page-enter">

  <h2>
    Dashboard Admin 
    <span id="notifBadge"
      style="background:red;color:white;border-radius:50%;
      padding:4px 9px;font-size:12px;display:none;">
      0
    </span>
  </h2>

    <!-- ================= GREETING ================= -->
<div class="greeting-card">

  <div class="greeting-text">

    <h3>
    <span id="greetingText"></span>, <%= admin.nama_admin || admin.username %>
    </h3>

    <p id="greetingMessage"></p>

    <h4 id="todayDate"></h4>

    <div id="liveClock"></div>

  </div>

</div>

  <!-- ================= CARD STATISTIK ================= -->
  <div class="dashboard-cards">

    <div class="card total">
        <h4>👩‍🎓 Total Siswa</h4>
        <div class="value"><%= totalSiswa %></div>
    </div>

    <div class="card aktif">
        <h4>🟢 Siswa Aktif</h4>
        <div class="value"><%= siswaAktif %></div>
    </div>

    <div class="card nonaktif">
        <h4>🟠 Siswa Nonaktif</h4>
        <div class="value"><%= siswaNonaktif %></div>
    </div>

    <div class="card assign">
        <h4>⚠️ Belum Assign Kelas</h4>
        <div class="value"><%= belumAssign %></div>
    </div>

    <div class="card kelas">
        <h4>🏫 Total Kelas</h4>
        <div class="value"><%= totalKelas %></div>
    </div>

    <div class="card tentor">
        <h4>👨‍🏫 Total Tentor</h4>
        <div class="value"><%= totalTentor %></div>
    </div>

    <div class="card laki">
        <h4>👦 Siswa Laki-laki</h4>
        <div class="value"><%= totalLaki %></div>
    </div>

    <div class="card perempuan">
        <h4>👧 Siswa Perempuan</h4>
        <div class="value"><%= totalPerempuan %></div>
    </div>

  </div>

  <!-- ================= GENERATE TAGIHAN ================= -->
  <div style="margin-top:20px;">
    <button
        id="btnGenerate"
        style="
            padding:10px 18px;
            background:#f39c12;
            color:white;
            border:none;
            border-radius:8px;
            cursor:pointer;
            font-weight:bold;
        "
    >
        ⚙️ Generate Tagihan
    </button>
</div>

  <!-- ================= REMINDER ================= -->
  <div class="section-box" style="margin-top:20px;">

    <h3>🔔 Pengingat Pembayaran</h3>

    <div class="table-wrapper">

      <table>

        <thead>
          <tr>
            <th>No</th>
            <th>Nama Siswa</th>
            <th>Jatuh Tempo</th>
            <th>Jumlah</th>
            <th>Aksi</th>
          </tr>
        </thead>

        <tbody>

          <% if (reminders && reminders.length > 0) { %>

            <% reminders.forEach(function(r, i) { %>

              <tr>

                <td><%= i + 1 %></td>

                <td><%= r.nama_lengkap %></td>

                <td>
                  <%= new Date(r.tanggal_tagihan).toLocaleDateString('id-ID') %>
                </td>

                <td>
                  Rp <%= r.jumlah != null ? r.jumlah.toLocaleString('id-ID') : '0' %>
                </td>

                <td>
                  <a href="/pembayaran/whatsapp/preview"
                    style="
                    padding:6px 12px;
                    background:#25D366;
                    color:white;
                    border-radius:6px;
                    text-decoration:none;
                  ">
                    📲 Kirim WA
                  </a>
                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>

              <td colspan="5">
                ✅ Tidak ada pembayaran jatuh tempo 
              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

  <!-- ================= JADWAL HARI INI ================= -->
  <div class="section-box" style="margin-top:20px;">

    <h3>📅 Jadwal Hari Ini</h3>

    <% if (jadwalHariIni && jadwalHariIni.length > 0) { %>

      <div class="table-wrapper">

        <table>

          <thead>
            <tr>
              <th>Jam</th>
              <th>Tempat</th>
              <th>Kelas</th>
            </tr>
          </thead>

          <tbody>

            <% jadwalHariIni.forEach(function(j) { %>

              <tr class="
                <%= j.status === 'berlangsung' ? 'row-berlangsung' : '' %>
                <%= j.status === 'selesai' ? 'row-selesai' : '' %>
              ">

                <td>
                  <b><%= j.sesi %></b><br>
                  <%= j.jam_mulai %> - <%= j.jam_selesai %>
                </td>

                <td>
                  <%= j.tempat %>
                </td>

                <td>
                  <%= j.jenjang %> - <%= j.nama_kelas %><br>

                  <% if (j.status === 'berlangsung') { %>

                    <span style="color:green;font-weight:bold;">
                      ● Sedang berlangsung
                    </span>

                  <% } else if (j.status === 'selesai') { %>

                    <span style="color:red;">
                      ● Selesai
                    </span>

                  <% } else { %>

                    <span style="color:gray;">
                      ● Belum mulai
                    </span>

                  <% } %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } else { %>

      <p>Tidak ada jadwal hari ini</p>

    <% } %>

  </div>

  <!-- ================= KELAS HAMPIR PENUH ================= -->
  <div class="section-box" style="margin-top:20px;">

    <h3>⚠️ Kelas Hampir Penuh</h3>

    <% if (kelasPenuh && kelasPenuh.length > 0) { %>

      <div class="table-wrapper">

        <table>

          <thead>
            <tr>
              <th>Kelas</th>
              <th>Kapasitas</th>
              <th>Jumlah</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>

            <% kelasPenuh.forEach(function(k) { %>

              <tr>

                <td>
                  <%= k.jenjang %> - <%= k.nama_kelas %>
                </td>

                <td>
                  <%= k.kapasitas %>
                </td>

                <td>
                  <%= k.jumlah_siswa %>
                </td>

                <td>

                  <% if (k.jumlah_siswa >= k.kapasitas) { %>

                    <span style="color:red;font-weight:bold;">
                      PENUH
                    </span>

                  <% } else { %>

                    <span style="color:orange;font-weight:bold;">
                      HAMPIR
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } else { %>

      <p>Belum ada kelas yang penuh</p>

    <% } %>

  </div>

</div>

<!-- ================= POPUP NOTIF ================= -->
<div id="popupNotif"
  style="
  display:none;
  position:fixed;
  top:20px;
  right:20px;
  background:#2ecc71;
  color:white;
  padding:16px;
  border-radius:10px;
  box-shadow:0 6px 20px rgba(0,0,0,0.2);
  z-index:9999;
  font-weight:bold;
">

  🎉 Siswa baru mendaftar!

</div>

<!-- 🔊 SOUND NOTIFICATION -->
<audio id="notifSound" preload="auto">
  <source src="/sounds/notif.mp3" type="audio/mpeg">
</audio>


<%- include('partials/footer') %>


<script>
// ================= GREETING =================

function updateGreeting(){

    const now = new Date();

    const hour = now.getHours();

    let greeting = "";
    let message = "";
    let icon = "";

    if(hour >= 0 && hour < 11){

        icon = "🌤️";
        greeting = "Selamat Pagi";
        message = "Semoga hari Anda menyenangkan dan penuh semangat 🌸";

    }else if(hour >= 11 && hour < 15){

        icon = "☀️";
        greeting = "Selamat Siang";
        message = "Semoga aktivitas hari ini berjalan lancar 😊";

    }else if(hour >= 15 && hour < 18){

        icon = "🌇";
        greeting = "Selamat Sore";
        message = "Semoga pekerjaan hari ini segera terselesaikan ✨";

    }else{

        icon = "🌙";
        greeting = "Selamat Malam";
        message = "Terima kasih telah bekerja hari ini, semoga istirahat Anda menyenangkan 🌙";

    }

    document.getElementById("greetingText").innerHTML =
    `${icon} ${greeting}`;

    document.getElementById("greetingMessage").innerHTML =
        message;

    const hari = [
        "Minggu",
        "Senin",
        "Selasa",
        "Rabu",
        "Kamis",
        "Jumat",
        "Sabtu"
    ];

    const bulan = [
        "Januari",
        "Februari",
        "Maret",
        "April",
        "Mei",
        "Juni",
        "Juli",
        "Agustus",
        "September",
        "Oktober",
        "November",
        "Desember"
    ];

    document.getElementById("todayDate").innerHTML =
        `${hari[now.getDay()]}, ${now.getDate()} ${bulan[now.getMonth()]} ${now.getFullYear()}`;

    const jam = String(now.getHours()).padStart(2,"0");
    const menit = String(now.getMinutes()).padStart(2,"0");
    const detik = String(now.getSeconds()).padStart(2,"0");

    document.getElementById("liveClock").innerHTML =
        `${jam}:${menit}:${detik} WIB`;

}

updateGreeting();

setInterval(updateGreeting,1000);
</script>

<script>
const btnGenerate = document.getElementById("btnGenerate");

if(btnGenerate){

btnGenerate.addEventListener("click", async ()=>{

    const konfirmasi = await Swal.fire({
        title:"Generate Tagihan?",
        text:"Sistem akan membuat tagihan pembayaran yang belum tersedia.",
        icon:"question",
        width:"330px",
        showCancelButton:true,
        confirmButtonText:"Ya, Generate",
        cancelButtonText:"Batal",
        confirmButtonColor:"#28a745",
        cancelButtonColor:"#d33"
    });

    if(!konfirmasi.isConfirmed) return;

    btnGenerate.disabled = true;
    btnGenerate.innerHTML = "⏳ Generating...";

    try{

        const res = await fetch("/pembayaran/generate",{
            method:"POST"
        });

        const data = await res.json();

        if(data.success){

            await Swal.fire({
                icon:"success",
                title:"Berhasil",
                text:data.message,
                timer:1500,
                showConfirmButton:false,
                width:"330px"
            });

            window.location.href="/pembayaran";

        }else{

            Swal.fire({
                icon:"error",
                title:"Gagal",
                text:data.message,
                width:"330px"
            });

            btnGenerate.disabled = false;
            btnGenerate.innerHTML="⚙️ Generate Tagihan";

        }

    }catch(err){

        Swal.fire({
            icon:"error",
            title:"Terjadi Kesalahan",
            text:"Generate tagihan gagal.",
            width:"330px"
        });

        btnGenerate.disabled=false;
        btnGenerate.innerHTML="⚙️ Generate Tagihan";

    }

});

}
</script>
