<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content page-enter">

  <h2>
    Dashboard Admin 
    <span id="notifBadge"
      style="background:red;color:white;border-radius:50%;
      padding:4px 9px;font-size:12px;display:none;">
      0
    </span>
  </h2>

  <!-- ================= CARD STATISTIK ================= -->
  <div class="dashboard-cards">

    <div class="card total">
        <h4>👩‍🎓 Total Siswa</h4>
        <div class="value"><%= totalSiswa %></div>
    </div>

    <div class="card aktif">
        <h4>🟢 Siswa Aktif</h4>
        <div class="value"><%= siswaAktif %></div>
    </div>

    <div class="card nonaktif">
        <h4>🟠 Siswa Nonaktif</h4>
        <div class="value"><%= siswaNonaktif %></div>
    </div>

    <div class="card assign">
        <h4>⚠️ Belum Assign Kelas</h4>
        <div class="value"><%= belumAssign %></div>
    </div>

    <div class="card kelas">
        <h4>🏫 Total Kelas</h4>
        <div class="value"><%= totalKelas %></div>
    </div>

    <div class="card tentor">
        <h4>👨‍🏫 Total Tentor</h4>
        <div class="value"><%= totalTentor %></div>
    </div>

    <div class="card laki">
        <h4>👦 Siswa Laki-laki</h4>
        <div class="value"><%= totalLaki %></div>
    </div>

    <div class="card perempuan">
        <h4>👧 Siswa Perempuan</h4>
        <div class="value"><%= totalPerempuan %></div>
    </div>

  </div>

  <!-- ================= GENERATE TAGIHAN ================= -->
  <div style="margin-top:20px;">
    <a href="/pembayaran/generate"
      style="
      display:inline-block;
      padding:10px 18px;
      background:#f39c12;
      color:white;
      border-radius:8px;
      text-decoration:none;
      font-weight:bold;
    ">
      ⚙️ Generate Tagihan 
    </a>
  </div>

  <!-- ================= REMINDER ================= -->
  <div class="section-box" style="margin-top:20px;">

    <h3>🔔 Pengingat Pembayaran</h3>

    <div class="table-wrapper">

      <table>

        <thead>
          <tr>
            <th>No</th>
            <th>Nama Siswa</th>
            <th>Jatuh Tempo</th>
            <th>Jumlah</th>
            <th>Aksi</th>
          </tr>
        </thead>

        <tbody>

          <% if (reminders && reminders.length > 0) { %>

            <% reminders.forEach(function(r, i) { %>

              <tr>

                <td><%= i + 1 %></td>

                <td><%= r.nama_lengkap %></td>

                <td>
                  <%= new Date(r.tanggal_tagihan).toLocaleDateString('id-ID') %>
                </td>

                <td>
                  Rp <%= r.jumlah != null ? r.jumlah.toLocaleString('id-ID') : '0' %>
                </td>

                <td>
                  <a href="/pembayaran/whatsapp/preview"
                    style="
                    padding:6px 12px;
                    background:#25D366;
                    color:white;
                    border-radius:6px;
                    text-decoration:none;
                  ">
                    📲 Kirim WA
                  </a>
                </td>

              </tr>

            <% }) %>

          <% } else { %>

            <tr>

              <td colspan="5">
                ✅ Tidak ada pembayaran jatuh tempo 
              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </div>

  <!-- ================= JADWAL HARI INI ================= -->
  <div class="section-box" style="margin-top:20px;">

    <h3>📅 Jadwal Hari Ini</h3>

    <% if (jadwalHariIni && jadwalHariIni.length > 0) { %>

      <div class="table-wrapper">

        <table>

          <thead>
            <tr>
              <th>Jam</th>
              <th>Tempat</th>
              <th>Kelas</th>
            </tr>
          </thead>

          <tbody>

            <% jadwalHariIni.forEach(function(j) { %>

              <tr class="
                <%= j.status === 'berlangsung' ? 'row-berlangsung' : '' %>
                <%= j.status === 'selesai' ? 'row-selesai' : '' %>
              ">

                <td>
                  <b><%= j.sesi %></b><br>
                  <%= j.jam_mulai %> - <%= j.jam_selesai %>
                </td>

                <td>
                  <%= j.tempat %>
                </td>

                <td>
                  <%= j.jenjang %> - <%= j.nama_kelas %><br>

                  <% if (j.status === 'berlangsung') { %>

                    <span style="color:green;font-weight:bold;">
                      ● Sedang berlangsung
                    </span>

                  <% } else if (j.status === 'selesai') { %>

                    <span style="color:red;">
                      ● Selesai
                    </span>

                  <% } else { %>

                    <span style="color:gray;">
                      ● Belum mulai
                    </span>

                  <% } %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } else { %>

      <p>Tidak ada jadwal hari ini</p>

    <% } %>

  </div>

  <!-- ================= KELAS HAMPIR PENUH ================= -->
  <div class="section-box" style="margin-top:20px;">

    <h3>⚠️ Kelas Hampir Penuh</h3>

    <% if (kelasPenuh && kelasPenuh.length > 0) { %>

      <div class="table-wrapper">

        <table>

          <thead>
            <tr>
              <th>Kelas</th>
              <th>Kapasitas</th>
              <th>Jumlah</th>
              <th>Status</th>
            </tr>
          </thead>

          <tbody>

            <% kelasPenuh.forEach(function(k) { %>

              <tr>

                <td>
                  <%= k.jenjang %> - <%= k.nama_kelas %>
                </td>

                <td>
                  <%= k.kapasitas %>
                </td>

                <td>
                  <%= k.jumlah_siswa %>
                </td>

                <td>

                  <% if (k.jumlah_siswa >= k.kapasitas) { %>

                    <span style="color:red;font-weight:bold;">
                      PENUH
                    </span>

                  <% } else { %>

                    <span style="color:orange;font-weight:bold;">
                      HAMPIR
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } else { %>

      <p>Belum ada kelas yang penuh</p>

    <% } %>

  </div>

</div>

<!-- ================= POPUP NOTIF ================= -->
<div id="popupNotif"
  style="
  display:none;
  position:fixed;
  top:20px;
  right:20px;
  background:#2ecc71;
  color:white;
  padding:16px;
  border-radius:10px;
  box-shadow:0 6px 20px rgba(0,0,0,0.2);
  z-index:9999;
  font-weight:bold;
">

  🎉 Siswa baru mendaftar!

</div>

<!-- 🔊 SOUND NOTIFICATION -->
<audio id="notifSound" preload="auto">
  <source src="/sounds/notif.mp3" type="audio/mpeg">
</audio>


<%- include('partials/footer') %>

<!-- ================= SCRIPT NOTIF ================= -->
<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

// 🔓 UNLOCK AUDIO BROWSER
document.addEventListener('click', () => {

  const sound = document.getElementById('notifSound');

  sound.play()
    .then(() => {
      sound.pause();
      sound.currentTime = 0;
    })
    .catch(() => {});

}, { once: true });

// register user
socket.emit('register', {
  userId: '<%= admin.username %>'
});

// ================= REALTIME SOCKET =================
socket.on('pendaftarBaru', (data) => {

  const badge = document.getElementById('notifBadge');
  const popup = document.getElementById('popupNotif');

  let current = parseInt(badge.innerText || 0);

  current++;

  badge.style.display = 'inline-block';
  badge.innerText = current;

  popup.innerText = `🎉 ${data.nama} baru saja mendaftar!`;

  popup.style.display = 'block';

  // 🔊 PLAY SOUND
  const sound = document.getElementById('notifSound');

  sound.currentTime = 0;

  sound.play().catch((err) => {
    console.log('Audio autoplay diblok browser');
  });

  setTimeout(() => {
    popup.style.display = 'none';
  }, 5000);

});

// ================= FALLBACK =================
async function cekNotif() {

  try {

    const res = await fetch('/notif/pendaftar-baru');

    const data = await res.json();

    const badge = document.getElementById('notifBadge');

    if (data.jumlah > 0) {

      badge.style.display = 'inline-block';
      badge.innerText = data.jumlah;

    } else {

      badge.style.display = 'none';

    }

  } catch (err) {

    console.error('Notif error:', err);

  }

}

// polling backup
setInterval(cekNotif, 10000);

cekNotif();

</script>
