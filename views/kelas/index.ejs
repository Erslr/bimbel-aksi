<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="content">

  <!-- ================= HEADER ================= -->
<div class="page-header">

    <h2>📚 Data Kelas</h2>

    <a href="/kelas/add" class="btn-add">
        + Tambah Kelas
    </a>

</div>

<!-- SEARCH -->
<div class="search-wrapper">

    <form action="/kelas" method="GET" class="search-form">

        <input
            type="text"
            name="keyword"
            value="<%= keyword %>"
            placeholder="🔍 Cari nama kelas, mapel, jenjang..."
            class="search-input"
        >

        <a href="/kelas" class="btn-reset">
            Reset
        </a>

    </form>

</div>

<!-- INFO DATA -->
<div class="info-data">

<% if(totalData === 0){ %>

    <span class="info-kosong">
        📚 Tidak ada kelas yang sesuai
    </span>

<% } else if(totalData === 1){ %>

    <span class="info-satu">
        📚 Ditemukan <strong>1</strong> kelas
    </span>

<% } else { %>

    <span class="info-banyak">
        📚 Ditemukan <strong><%= totalData %></strong> kelas
    </span>

<% } %>

</div>
  <!-- ================= TABLE ================= -->
  <div class="table-wrapper">

    <table>
      <thead>
        <tr>
          <th>No</th>
          <th>Nama Kelas</th>
          <th>Jenjang</th>
          <th>Mapel</th>
          <th>Tempat</th>
          <th>Jadwal</th>
          <th>Jam</th>
          <th>Kapasitas</th>
          <th>Aksi</th>
        </tr>
      </thead>

      <tbody>
        <% if (kelas.length > 0) { %>

          <% kelas.forEach((k, i) => { %>
          <tr>

            <td><%= i + 1 %></td>

           
            <td><%= k.nama_kelas %></td>
            <td><%= k.jenjang %></td>
            <td><%= k.mapel %></td>
            <td><%= k.tempat_les %></td>
            <td>
              <span class="badge-info">
                <%= k.jadwal %>
              </span>
            </td>

            <td>
              <%= k.jam_mulai %> - <%= k.jam_selesai %>
            </td>

            <td>
              <span class="badge-capacity">
                <%= k.kapasitas %>
              </span>
            </td>

            <!-- ================= AKSI ================= -->
            <td class="aksi">

              <a href="/kelas/edit/<%= k.id_kelas %>" class="btn-edit">
                ✏️ Edit
              </a>

              <a href="#"
                onclick="hapusKelas('<%= k.id_kelas %>')"
                class="btn-delete">
                🗑 Hapus
              </a>
            </td>

          </tr>
          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="9" style="text-align:center; padding:20px;">
              Tidak ada data kelas
            </td>
          </tr>

        <% } %>
      </tbody>

    </table>

  </div>

</div>
<script>

// =============================
// DOM Ready
// =============================
document.addEventListener("DOMContentLoaded", () => {

    tampilkanNotifikasi();

    // =============================
    // Auto Search
    // =============================
    const searchInput = document.querySelector('input[name="keyword"]');

    if (searchInput) {

        let timer;

        searchInput.addEventListener('input', function () {

            clearTimeout(timer);

            timer = setTimeout(() => {
                this.form.submit();
            }, 500);

        });

    }

});

// =============================
// SweetAlert Notifikasi
// =============================
function tampilkanNotifikasi() {

    const success = "<%= success || '' %>";
    const error = "<%= error || '' %>";

    if (success !== "") {

        const pesan = {
            tambah: "Data kelas berhasil ditambahkan.",
            edit: "Data kelas berhasil diperbarui.",
            hapus: "Data kelas berhasil dihapus."
        };

        Swal.fire({
            icon: "success",
            title: "Berhasil",
            text: pesan[success],
            confirmButtonColor: "#3085d6",
            width: '330px'
        });

    }

    if (error !== "") {

        const pesan = {
            tambah: "Data kelas gagal ditambahkan.",
            edit: "Data kelas gagal diperbarui.",
            hapus: "Data kelas gagal dihapus."
        };

        Swal.fire({
            icon: "error",
            title: "Gagal",
            text: pesan[error],
            confirmButtonColor: "#d33",
            width: '330px'
        });

    }

}

// =============================
// SweetAlert Hapus
// =============================
function hapusKelas(id){

    Swal.fire({
        title: "Yakin ingin menghapus?",
        text: "Data kelas yang dihapus tidak dapat dikembalikan.",
        icon: "warning",
        width: "330px",
        showCancelButton: true,
        confirmButtonColor: "#d33",
        cancelButtonColor: "#6c757d",
        confirmButtonText: "Ya, Hapus",
        cancelButtonText: "Batal"
    }).then((result)=>{

        if(result.isConfirmed){
            window.location.href = "/kelas/delete/" + id;
        }

    });

}

</script>
<%- include('../partials/footer') %>