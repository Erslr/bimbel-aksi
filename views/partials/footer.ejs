<!-- Lucide Icon -->
<script src="https://unpkg.com/lucide@latest"></script>
<script>
    lucide.createIcons();
</script>

<!-- SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

function konfirmasiLogout(){

    Swal.fire({
        title:"Logout?",
        text:"Anda akan keluar dari sistem.",
        icon:"warning",
        width:"330px",
        showCancelButton:true,
        confirmButtonText:"Ya, Logout",
        cancelButtonText:"Batal",
        confirmButtonColor:"#d33"
    }).then((result)=>{

        if(result.isConfirmed){

            window.location.href="/logout";

        }

    });

}

</script>

<!-- SOCKET -->
<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

let daftarNotif = [];
let popupSedangTampil = false;

// ==========================
// UNLOCK AUDIO
// ==========================
document.addEventListener("click", () => {

    const audio = document.getElementById("notifSound");

    audio.play()
        .then(() => {
            audio.pause();
            audio.currentTime = 0;
        })
        .catch(() => {});

}, { once:true });


// ==========================
// PLAY SOUND
// ==========================
function bunyikanNotif(){

    const audio = document.getElementById("notifSound");

    audio.currentTime = 0;

    audio.play().catch(()=>{

        console.log("Browser memblokir autoplay.");

    });

}


// ==========================
// SOCKET REALTIME
// ==========================
socket.on("pendaftarBaru", (data) => {

    console.log("🔥 SOCKET MASUK");
    console.log(data);

    daftarNotif.unshift({
        pesan: data.pesan
    });

    bunyikanNotif();

    if (!popupSedangTampil) {
        tampilkanNotif();
    }

});

// ==========================
// LOAD DARI DATABASE
// ==========================
async function loadNotif(){

    try{

        const res = await fetch('/notifikasi');

        daftarNotif = await res.json();

        if(daftarNotif.length>0){

            bunyikanNotif();

            tampilkanNotif();

        }

    }catch(err){

        console.log(err);

    }

}

loadNotif();

// ==========================
// REFRESH DATA SISWA
// ==========================
function refreshHalamanJikaPerlu(){

    const path = window.location.pathname;

    if(path === "/siswa"){

        window.location.reload();

    }

}

// ==========================
// SWEET ALERT
// ==========================
async function tampilkanNotif(){

    if(daftarNotif.length===0) return;

    popupSedangTampil = true;

    const total = daftarNotif.length;

    // tampilkan maksimal 3 nama terbaru
    const daftarNama = daftarNotif
        .slice(0,3)
        .map(n => {

            const nama = n.pesan.split(" telah")[0];

            return `<li>${nama}</li>`;

        })
        .join("");

    const sisa = total > 3
        ? `<p style="margin-top:8px;color:#777;">+${total-3} siswa lainnya...</p>`
        : "";

    const isi = `

        <p style="margin-bottom:15px;font-size:15px;">
            Terdapat
            <b>${total} siswa</b>
            yang telah melakukan pendaftaran
            dan sedang menunggu konfirmasi admin.
        </p>

        <div style="
            background:#f8f9fa;
            padding:14px;
            border-radius:10px;
            text-align:left;
        ">

            <b>Daftar terbaru:</b>

            <ul style="
                margin-top:10px;
                padding-left:18px;
                line-height:1.8;
            ">
                ${daftarNama}
            </ul>

            ${sisa}

        </div>

        <p style="
            margin-top:18px;
            font-size:14px;
        ">
            Silakan buka menu
            <b>Data Siswa</b>
            untuk melakukan konfirmasi.
        </p>

    `;

    const hasil = await Swal.fire({

        icon:"info",

        title:`🔔 Pendaftaran Siswa Baru`,

        html:isi,

        width:530,

        showCancelButton:true,

        confirmButtonText:"📋 Buka Data Siswa",

        cancelButtonText:"Tutup",

        confirmButtonColor:"#198754",

        cancelButtonColor:"#6c757d",

        allowOutsideClick:false,

        allowEscapeKey:false

    });

    await fetch("/notifikasi/read",{
        method:"POST"
    });

    daftarNotif=[];

    popupSedangTampil=false;

    if(hasil.isConfirmed){

        window.location.href="/siswa?status=baru";

    }

}
</script>

<!-- AUDIO -->
<audio id="notifSound" preload="auto">
    <source src="/sounds/notif.mp3" type="audio/mpeg">
</audio>

</body>
</html>