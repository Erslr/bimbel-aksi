<div class="sidebar">

  <div class="sidebar-logo">
    <img src="/images/logo.png" alt="logo">
    <span>Bimbel AKSI</span>
  </div>

  <hr>

  <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>">
  <i data-lucide="house"></i>
  <span>Dashboard</span>
</a>

<a href="/siswa" class="<%= activePage === 'siswa' ? 'active' : '' %>">
    <i data-lucide="user"></i>

    <span>Siswa</span>

    <% if (siswaBaru > 0) { %>
        <span class="badge-notif">
            <%= siswaBaru > 99 ? '99+' : siswaBaru %>
        </span>
    <% } %>
</a>

<a href="/kelas" class="<%= activePage === 'kelas' ? 'active' : '' %>">
  <i data-lucide="monitor"></i>
  <span>Kelas</span>
</a>

<a href="/tentor" class="<%= activePage === 'tentor' ? 'active' : '' %>">
  <i data-lucide="book-open"></i>
  <span>Tentor</span>
</a>

<a href="/pembayaran" class="<%= activePage === 'pembayaran' ? 'active' : '' %>">
  <i data-lucide="credit-card"></i>
  <span>Pembayaran</span>
</a>

<hr>

<a href="#" onclick="konfirmasiLogout()">
  <i data-lucide="log-out"></i>
  <span>Logout</span>
</a>

</div>