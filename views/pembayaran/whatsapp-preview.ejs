<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="content">

  <div class="page-header">
    <h2>📲 Preview WhatsApp Tagihan </h2>

  </div>

  <% if (!siswa || siswa.length === 0) { %>

    <div style="
      padding:15px;
      background:#e3f2fd;
      border-left:5px solid #2196f3;
      border-radius:8px;
    ">
      ✅ Tidak ada siswa yang mendekati jatuh tempo
    </div>

  <% } else { %>

    <div class="table-wrapper">

      <table border="1" cellpadding="8" cellspacing="0" width="100%">

        <thead>
          <tr>
            <th>No</th>
            <th>Nama Siswa</th>
            <th>Jatuh Tempo</th>
            <th>Pesan WhatsApp</th>
            <th>Status WA</th>
            <th>Aksi</th>
          </tr>
        </thead>

        <tbody>

          <% siswa.forEach((s, i) => { 

            const tanggalObj = s.tanggal_tagihan
              ? new Date(s.tanggal_tagihan)
              : null;

            const tanggal = tanggalObj
              ? tanggalObj.toLocaleDateString('id-ID')
              : '-';

            const jumlah = s.jumlah
              ? Number(s.jumlah).toLocaleString('id-ID')
              : '0';

            const defaultPesan = `Halo ${s.nama_lengkap || ''} 👋

Kami dari *Bimbel AKSI* ingin mengingatkan pembayaran les:

📅 Jatuh Tempo: ${tanggal}
💰 Jumlah: Rp ${jumlah}

Sebelumnya kami juga ingin menanyakan, apakah lesnya masih ingin dilanjutkan untuk bulan berikutnya? 😊

Mohon konfirmasinya, Terima kasih 🙏`;

            const pesan =
              s.custom_pesan &&
              s.custom_pesan.trim() !== ''
                ? s.custom_pesan
                : defaultPesan;

          %>

          <tr>

            <td align="center">
              <%= i + 1 %>
            </td>

            <td>
              <%= s.nama_lengkap %>
            </td>

            <td align="center">
              <%= tanggal %>
            </td>

            <!-- ================= EDIT PESAN ================= -->
            <td style="min-width:380px;">

              <form
                action="/pembayaran/whatsapp/update-pesan/<%= s.id_pembayaran %>"
                method="POST"
                style="
                  display:flex;
                  flex-direction:column;
                  gap:10px;
                  align-items:stretch;
                ">

                <textarea
                  name="custom_pesan"
                  rows="7"
                  style="
                    width:100%;
                    min-width:100%;
                    max-width:100%;
                    font-size:13px;
                    line-height:1.5;
                    border-radius:10px;
                    border:1px solid #dcdcdc;
                    padding:12px;
                    resize:vertical;
                    box-sizing:border-box;
                    background:#fafafa;
                  "
                ><%- pesan %></textarea>

                <button
                  type="submit"
                  style="
                    width:fit-content;
                    padding:8px 14px;
                    background:#0288d1;
                    color:white;
                    border:none;
                    border-radius:8px;
                    cursor:pointer;
                    font-weight:bold;
                    box-shadow:0 3px 8px rgba(0,0,0,0.12);
                  ">
                  💾 Update Pesan
                </button>

              </form>

            </td>

            <!-- ================= STATUS WA ================= -->
            <td align="center">

              <% if (s.wa_terkirim) { %>

                <span style="
                  background:#e9f9f1;
                  color:#27ae60;
                  padding:5px 10px;
                  border-radius:12px;
                  font-size:12px;
                  font-weight:bold;
                ">
                  ✔ Sudah Dikirim
                </span>

              <% } else { %>

                <span style="
                  background:#fff4e5;
                  color:#d68910;
                  padding:5px 10px;
                  border-radius:12px;
                  font-size:12px;
                  font-weight:bold;
                ">
                  ⏳ Belum
                </span>

              <% } %>

            </td>

            <!-- ================= AKSI ================= -->
            <td align="center">
              <% if (s.status !== 'lunas') { %>

                <button
                  onclick="kirimWA('<%= s.id_pembayaran %>')"
                  style="
                    padding:7px 12px;
                    background:#25D366;
                    color:white;
                    border:none;
                    border-radius:6px;
                    font-weight:bold;
                    cursor:pointer;
                    margin-bottom:6px;
                  ">
                  📤 Kirim WA
                </button>

                <br>

                <!-- TANDAI -->
                <form
                  action="/pembayaran/whatsapp/tandai/<%= s.id_pembayaran %>"
                  method="POST"
                  style="display:inline-block">

                  <button
                    style="
                      padding:6px 10px;
                      background:#2196f3;
                      color:white;
                      border:none;
                      border-radius:6px;
                      cursor:pointer;
                    ">
                    ✔ Tandai
                  </button>

                </form>

              <% } else { %>

                <span style="color:#888;">-</span>

              <% } %>

            </td>

          </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  <% } %>

</div>

<!-- ========================================= -->
<!-- 🔥 SCRIPT -->
<!-- ========================================= -->

<script>

// ======================================
// KIRIM 1 WHATSAPP
// ======================================
async function kirimWA(id) {

  try {

    const res = await fetch(`/pembayaran/whatsapp/kirim/${id}`, {
      method: 'POST'
    });

    const data = await res.json();

    // =========================
    // jika berhasil
    // =========================
    if (data.waLink) {

      // otomatis tandai terkirim DULU
      await fetch(`/pembayaran/whatsapp/tandai/${id}`, {
        method: 'POST'
      });

      // baru buka whatsapp
      window.location.href = data.waLink;

      // reload halaman
      setTimeout(() => {
        location.reload();
      }, 800);

    } else {

      alert(data.message || 'Gagal membuat link WhatsApp');

    }

  } catch (err) {

    console.error(err);
    alert('Gagal kirim WhatsApp');

  }

}


</script>

<%- include('../partials/footer') %>