<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Form Pendaftaran Siswa Bimbel AKSI</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
      font-family: 'Poppins', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      min-height: 100vh;
      margin: 0;
      padding: 30px 15px;
    }

    .container {
      max-width: 900px;
      width: 100%;
      margin: auto;
      background: #fff;
      padding: 30px;
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0,0,0,.25);
      animation: fadeInUp .6s ease;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    h1 {
      text-align: center;
      color: #1e3a8a;
      margin-bottom: 8px;
      font-weight: 600;
    }

    .subtitle {
      text-align: center;
      color: #64748b;
      font-size: 14px;
      margin-bottom: 30px;
    }

    .section {
      margin-bottom: 28px;
      padding: 20px;
      border-radius: 14px;
      background: #f8fafc;
      border: 1px solid #e5e7eb;
    }

    .section h3 {
      margin-bottom: 15px;
      color: #1e3a8a;
      border-left: 5px solid #1e3a8a;
      padding-left: 10px;
      font-size: 18px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 15px;
    }

    label {
      font-size: 13px;
      color: #334155;
      font-weight: 500;
    }

    input, select, textarea {
      width: 100%;
      padding: 11px 12px;
      border-radius: 10px;
      border: 1px solid #d1d5db;
      font-size: 14px;
      background: #f9fafb;
      transition: all .25s ease;
    }

    input:hover, select:hover, textarea:hover {
      border-color: #1e3a8a;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #1e3a8a;
      box-shadow: 0 0 0 2px rgba(30,58,138,.2);
      background: #fff;
    }

    textarea {
      resize: none;
    }

    .btn {
      width: 100%;
      padding: 15px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #1e3a8a, #1d4ed8);
      color: white;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 12px;
      box-shadow: 0 8px 18px rgba(30,58,138,.3);
      transition: all .3s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 22px rgba(30,58,138,.4);
    }

    .footer-note {
      text-align: center;
      font-size: 12px;
      color: #64748b;
      margin-top: 18px;
    }

    /* =========================
       RESPONSIVE MOBILE
    ========================== */
    @media (max-width: 768px) {

      body {
        padding: 0;
      }

      .container {
        max-width: 100%;
        width: 100%;
        margin: 0;
        border-radius: 0;
        padding: 20px 16px;
        min-height: 100vh;
      }

      h1 {
        font-size: 19px;
      }

      .subtitle {
        font-size: 13px;
      }

      .section {
        padding: 18px 14px;
        border-radius: 12px;
      }

      .section h3 {
        font-size: 16px;
      }

      .grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      input, select, textarea {
        font-size: 15px;
        padding: 13px;
      }

      .btn {
        font-size: 16px;
        padding: 16px;
        border-radius: 14px;
      }

      .footer-note {
        font-size: 11px;
      }

      /* Fix field alamat */
      .grid div[style*="grid-column"] {
        grid-column: span 1 
      }
    }
  </style>
</head>

<body>

<div class="container">
  <h1>Form Pendaftaran Siswa Bimbel AKSI</h1>
  <p class="subtitle">Isi data dengan benar.</p>

  <form id="formPendaftaran">

    <!-- DATA SISWA -->
    <div class="section">
      <h3>👩‍🎓 Data Siswa</h3>
      <div class="grid">

        <div>
          <label>Nama Lengkap</label>
          <input type="text" name="nama_lengkap" required />
        </div>

        <div>
          <label>Nama Panggilan</label>
          <input type="text" name="nama_panggilan" />
        </div>

        <div>
          <label>Tempat Lahir</label>
          <input type="text" name="tempat_lahir" />
        </div>

        <div>
          <label>Tanggal Lahir</label>
          <input type="date" name="tanggal_lahir" />
        </div>

        <div>
          <label>Jenis Kelamin</label>
          <select name="jenis_kelamin">
            <option value="">-- Pilih --</option>
            <option value="L">Laki-laki</option>
            <option value="P">Perempuan</option>
          </select>
        </div>

        <div>
          <label>No WhatsApp Siswa</label>
          <input type="text" name="wa_siswa" />
        </div>

        <div>
          <label>Asal Sekolah</label>
          <input type="text" name="asal_sekolah" />
        </div>

        <div>
          <label>Kelas Sekolah</label>
          <input type="text" name="kelas_sekolah" />
        </div>

        <div>
          <label>Jenjang</label>
          <select name="jenjang">
            <option value="SMP">SMP</option>
            <option value="SMA">SMA</option>
            <option value="SMK">SMK</option>
          </select>
        </div>

        <div>
          <label>Organisasi</label>
          <input type="text" name="organisasi" />
        </div>

        <div class="alamat-field">
          <label>Alamat</label>
          <textarea name="alamat" rows="3"></textarea>
        </div>

      </div>
    </div>

    <!-- DATA ORANG TUA -->
    <div class="section">
      <h3>👨‍👩‍👧 Data Orang Tua</h3>
      <div class="grid">

        <div>
          <label>Nama Orang Tua</label>
          <input type="text" name="nama_ortu" />
        </div>

        <div>
          <label>No WhatsApp Orang Tua</label>
          <input type="text" name="wa_ortu" />
        </div>

        <div>
          <label>Pekerjaan Orang Tua</label>
          <input type="text" name="pekerjaan_ortu" />
        </div>

      </div>
    </div>

    <!-- DATA BIMBEL -->
    <div class="section">
      <h3>📚 Data Bimbel</h3>
      <div class="grid">

        <div>
          <label>Hari Les</label>
          <input type="text" name="hari_les" />
        </div>

        <div>
          <label>Tanggal Masuk</label>
          <input type="date" name="tanggal_masuk" />
        </div>

        <div>
          <label>Mata Pelajaran</label>
          <input type="text" name="mapel" />
        </div>

        <div>
          <label>Jurusan Impian</label>
          <input type="text" name="jurusan_impian" />
        </div>

        <div>
          <label>Kampus Impian</label>
          <input type="text" name="kampus_impian" />
        </div>

        <div>
          <label>Sumber Informasi</label>
          <select name="sumber_info">
            <option value="Teman">Teman</option>
            <option value="Instagram">Instagram</option>
            <option value="Sekolah">Sekolah</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>

      </div>
    </div>

    <button class="btn" type="submit">Kirim Pendaftaran</button>

    <p class="footer-note">© Bimbel AKSI. All Rights Reserved.</p>

  </form>
</div>

<script>
const form = document.getElementById('formPendaftaran');

form.addEventListener('submit', async function(e) {

  e.preventDefault();

  const btn = document.querySelector('.btn');

  try {

    btn.disabled = true;
    btn.innerText = '⏳ Mengirim...';

    const formData = new URLSearchParams(new FormData(form));

    const res = await fetch('/pendaftaran-siswa', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: formData
    });

    const data = await res.json();

    console.log(data);

    // =========================
    // SUCCESS
    // =========================
    if (data.success) {

      await Swal.fire({

        icon: 'success',

        title: 'Pendaftaran Berhasil',

        text: 'Data berhasil dikirim. Admin akan segera memproses pendaftaran Anda.',

        width: 'auto',

        confirmButtonText: 'OK',

        buttonsStyling: false,

        customClass: {
          popup: 'pendaftaran-swal',
          confirmButton: 'pendaftaran-btn'
        }

      });

      form.reset();

      // Jika ada link WhatsApp Admin,
      // buka setelah tombol OK diklik
      if (data.waLink) {
        window.open(data.waLink, '_blank');
      }

    } else {

      Swal.fire({

        icon: 'error',

        title: 'Pendaftaran Gagal',

        text: data.message || 'Terjadi kesalahan.',

        width: 'auto',

        confirmButtonText: 'Tutup',

        buttonsStyling: false,

        customClass: {
          popup: 'pendaftaran-swal',
          confirmButton: 'pendaftaran-btn'
        }

      });

    }

  } catch (err) {

    console.error(err);

    Swal.fire({

      icon: 'error',

      title: 'Server Error',

      text: 'Terjadi kesalahan pada server.',

      width: 'auto',

      confirmButtonText: 'Tutup',

      buttonsStyling: false,

      customClass: {
        popup: 'pendaftaran-swal',
        confirmButton: 'pendaftaran-btn'
      }

    });

  } finally {

    btn.disabled = false;
    btn.innerText = 'Kirim Pendaftaran';

  }

});
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>