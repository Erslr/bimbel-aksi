<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Manajemen Admin | Bimbel AKSI</title>

  <!-- Favicon -->
  <link
    rel="icon"
    href="/favicon.ico?v=2"
  >

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <!-- CSS UTAMA -->
  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

</head>


<body>


  <!-- ==================================================
       SIDEBAR
  ================================================== -->

  <%- include('../partials/sidebar') %>


  <!-- ==================================================
       MAIN CONTENT
  ================================================== -->

  <div class="main-content">


    <!-- ==================================================
         PAGE HEADER
    ================================================== -->

    <div class="page-header">

      <div>

        <h1>
          Manajemen Admin
        </h1>

        <p>
          Kelola akun admin yang memiliki akses
          ke sistem Bimbel AKSI.
        </p>

      </div>


      <!-- TOMBOL KEMBALI -->

      <a
        href="/setting"
        class="setting-back-button"
      >

        <i data-lucide="arrow-left"></i>

        <span>
          Kembali
        </span>

      </a>

    </div>


    <!-- ==================================================
         ACTION BAR
    ================================================== -->

    <div class="admin-action-bar">

      <div class="admin-action-info">

        <div class="admin-action-icon">

          <i data-lucide="users-round"></i>

        </div>

        <div>

          <h2>
            Daftar Admin
          </h2>

          <p>
            Kelola pengguna yang memiliki akses
            ke sistem.
          </p>

        </div>

      </div>


      <button
        type="button"
        class="setting-primary-button"
        onclick="bukaModalTambah()"
      >

        <i data-lucide="user-plus"></i>

        <span>
          Tambah Admin
        </span>

      </button>

    </div>


    <!-- ==================================================
         TABLE ADMIN
    ================================================== -->

    <div class="setting-table-card">

      <div class="setting-table-wrapper">

        <table class="setting-admin-table">

          <thead>

            <tr>

              <th>No</th>

              <th>Nama Admin</th>

              <th>Username</th>

              <th>Nomor WhatsApp</th>

              <th>Status</th>

              <th>Aksi</th>

            </tr>

          </thead>


          <tbody>


            <% if (!admins || admins.length === 0) { %>

              <tr>

                <td
                  colspan="6"
                  class="setting-empty-state"
                >

                  <div>

                    <i data-lucide="users-round"></i>

                    <h3>
                      Belum ada data admin
                    </h3>

                    <p>
                      Belum terdapat akun admin
                      pada sistem.
                    </p>

                  </div>

                </td>

              </tr>

            <% } else { %>


              <% admins.forEach((admin, index) => { %>

                <tr>


                  <!-- NOMOR -->

                  <td>
                    <%= index + 1 %>
                  </td>


                  <!-- NAMA -->

                  <td>

                    <div class="admin-name-cell">

                      <div class="admin-avatar">

                        <%= (admin.nama_admin || 'A')
                          .charAt(0)
                          .toUpperCase() %>

                      </div>

                      <div>

                        <strong>
                          <%= admin.nama_admin || '-' %>
                        </strong>

                      </div>

                    </div>

                  </td>


                  <!-- USERNAME -->

                  <td>

                    <span class="admin-username">

                      @<%= admin.username || '-' %>

                    </span>

                  </td>


                  <!-- NOMOR WA -->

                  <td>

                    <% if (admin.nomor_wa) { %>

                      <span>
                        <%= admin.nomor_wa %>
                      </span>

                    <% } else { %>

                      <span class="admin-muted">
                        Belum diatur
                      </span>

                    <% } %>

                  </td>


                  <!-- STATUS -->

                  <td>

                    <% if (
                      Number(admin.id_admin) ===
                      Number(idAdminLogin)
                    ) { %>

                      <span class="admin-status active">

                        <span class="status-dot"></span>

                        Sedang Login

                      </span>

                    <% } else { %>

                      <span class="admin-status">

                        <span class="status-dot"></span>

                        Aktif

                      </span>

                    <% } %>

                  </td>


                  <!-- AKSI -->

                  <td>

                    <div class="admin-action-buttons">


                      <!-- EDIT ADMIN -->

                      <button
                        type="button"
                        class="admin-icon-button edit"
                        title="Edit Admin"

                        data-id="<%= admin.id_admin %>"
                        data-nama="<%= admin.nama_admin || '' %>"
                        data-username="<%= admin.username || '' %>"
                        data-nomorwa="<%= admin.nomor_wa || '' %>"

                        onclick="bukaModalEdit(this)"
                      >

                        <i data-lucide="pencil"></i>

                      </button>


                      <!-- RESET PASSWORD -->

                      <button
                        type="button"
                        class="admin-icon-button password"
                        title="Reset Password"

                        data-id="<%= admin.id_admin %>"
                        data-nama="<%= admin.nama_admin || '' %>"

                        onclick="bukaModalResetPassword(this)"
                      >

                        <i data-lucide="key-round"></i>

                      </button>


                      <!-- HAPUS -->

                      <% if (
                        Number(admin.id_admin) !==
                        Number(idAdminLogin)
                      ) { %>

                        <button
                          type="button"
                          class="admin-icon-button delete"
                          title="Hapus Admin"

                          data-id="<%= admin.id_admin %>"
                          data-nama="<%= admin.nama_admin || '' %>"

                          onclick="hapusAdmin(this)"
                        >

                          <i data-lucide="trash-2"></i>

                        </button>

                      <% } else { %>

                        <button
                          type="button"
                          class="admin-icon-button disabled"
                          title="Akun yang sedang digunakan tidak dapat dihapus"
                          disabled
                        >

                          <i data-lucide="shield-check"></i>

                        </button>

                      <% } %>


                    </div>

                  </td>


                </tr>

              <% }) %>


            <% } %>


          </tbody>

        </table>

      </div>

    </div>


  </div>


  <!-- ==================================================
       MODAL TAMBAH ADMIN
  ================================================== -->

  <div
    id="modalTambahAdmin"
    class="setting-modal"
  >

    <div
      class="setting-modal-overlay"
      onclick="tutupModalTambah()"
    >
    </div>


    <div class="setting-modal-box">


      <!-- HEADER -->

      <div class="setting-modal-header">

        <div>

          <div class="setting-modal-icon">

            <i data-lucide="user-plus"></i>

          </div>

          <h2>
            Tambah Admin
          </h2>

          <p>
            Tambahkan akun admin baru
            ke sistem Bimbel AKSI.
          </p>

        </div>


        <button
          type="button"
          class="setting-modal-close"
          onclick="tutupModalTambah()"
        >

          <i data-lucide="x"></i>

        </button>

      </div>


      <!-- FORM -->

      <form
        id="formTambahAdmin"
        action="/setting/admin/tambah"
        method="POST"
      >


        <!-- NAMA -->

        <div class="setting-form-group">

          <label>
            Nama Admin
            <span>*</span>
          </label>

          <input
            type="text"
            name="nama_admin"
            placeholder="Masukkan nama admin"
            required
          >

        </div>


        <!-- USERNAME -->

        <div class="setting-form-group">

          <label>
            Username
            <span>*</span>
          </label>

          <input
            type="text"
            name="username"
            placeholder="Masukkan username"
            autocomplete="off"
            required
          >

        </div>


        <!-- NOMOR WA -->

        <div class="setting-form-group">

          <label>
            Nomor WhatsApp
          </label>

          <input
            type="text"
            name="nomor_wa"
            placeholder="Contoh: 628xxxxxxxxxx"
          >

          <small>
            Nomor WhatsApp bersifat opsional.
          </small>

        </div>


        <!-- PASSWORD -->

        <div class="setting-form-group">

          <label>
            Password
            <span>*</span>
          </label>

          <div class="setting-password-wrapper">

            <input
              type="password"
              id="passwordTambah"
              name="password"
              placeholder="Minimal 6 karakter"
              autocomplete="new-password"
              required
            >

            <button
              type="button"
              onclick="togglePassword('passwordTambah', this)"
            >

              <i data-lucide="eye"></i>

            </button>

          </div>

        </div>


        <!-- FOOTER -->

        <div class="setting-modal-footer">

          <button
            type="button"
            class="setting-secondary-button"
            onclick="tutupModalTambah()"
          >

            Batal

          </button>

          <button
            type="submit"
            class="setting-primary-button"
          >

            <i data-lucide="user-plus"></i>

            Tambahkan Admin

          </button>

        </div>


      </form>

    </div>

  </div>


  <!-- ==================================================
       MODAL EDIT ADMIN
  ================================================== -->

  <div
    id="modalEditAdmin"
    class="setting-modal"
  >

    <div
      class="setting-modal-overlay"
      onclick="tutupModalEdit()"
    >
    </div>


    <div class="setting-modal-box">


      <!-- HEADER -->

      <div class="setting-modal-header">

        <div>

          <div class="setting-modal-icon">

            <i data-lucide="user-pen"></i>

          </div>

          <h2>
            Edit Admin
          </h2>

          <p>
            Ubah informasi akun admin.
          </p>

        </div>


        <button
          type="button"
          class="setting-modal-close"
          onclick="tutupModalEdit()"
        >

          <i data-lucide="x"></i>

        </button>

      </div>


      <!-- FORM -->

      <form
        id="formEditAdmin"
        method="POST"
      >


        <!-- NAMA -->

        <div class="setting-form-group">

          <label>
            Nama Admin
            <span>*</span>
          </label>

          <input
            type="text"
            id="editNamaAdmin"
            name="nama_admin"
            required
          >

        </div>


        <!-- USERNAME -->

        <div class="setting-form-group">

          <label>
            Username
            <span>*</span>
          </label>

          <input
            type="text"
            id="editUsername"
            name="username"
            autocomplete="off"
            required
          >

        </div>


        <!-- NOMOR WA -->

        <div class="setting-form-group">

          <label>
            Nomor WhatsApp
          </label>

          <input
            type="text"
            id="editNomorWa"
            name="nomor_wa"
            placeholder="Contoh: 628xxxxxxxxxx"
          >

        </div>


        <!-- FOOTER -->

        <div class="setting-modal-footer">

          <button
            type="button"
            class="setting-secondary-button"
            onclick="tutupModalEdit()"
          >

            Batal

          </button>

          <button
            type="submit"
            class="setting-primary-button"
          >

            <i data-lucide="save"></i>

            Simpan Perubahan

          </button>

        </div>


      </form>

    </div>

  </div>


  <!-- ==================================================
       MODAL RESET PASSWORD
  ================================================== -->

  <div
    id="modalResetPassword"
    class="setting-modal"
  >

    <div
      class="setting-modal-overlay"
      onclick="tutupModalResetPassword()"
    >
    </div>


    <div class="setting-modal-box">


      <!-- HEADER -->

      <div class="setting-modal-header">

        <div>

          <div class="setting-modal-icon">

            <i data-lucide="key-round"></i>

          </div>

          <h2>
            Reset Password
          </h2>

          <p id="resetPasswordDescription">
            Buat password baru untuk admin.
          </p>

        </div>


        <button
          type="button"
          class="setting-modal-close"
          onclick="tutupModalResetPassword()"
        >

          <i data-lucide="x"></i>

        </button>

      </div>


      <!-- FORM -->

      <form
        id="formResetPassword"
        method="POST"
      >


        <!-- PASSWORD BARU -->

        <div class="setting-form-group">

          <label>
            Password Baru
            <span>*</span>
          </label>

          <div class="setting-password-wrapper">

            <input
              type="password"
              id="passwordReset"
              name="password_baru"
              placeholder="Minimal 6 karakter"
              autocomplete="new-password"
              required
            >

            <button
              type="button"
              onclick="togglePassword('passwordReset', this)"
            >

              <i data-lucide="eye"></i>

            </button>

          </div>

        </div>


        <!-- KONFIRMASI -->

        <div class="setting-form-group">

          <label>
            Konfirmasi Password
            <span>*</span>
          </label>

          <div class="setting-password-wrapper">

            <input
              type="password"
              id="passwordResetConfirm"
              name="konfirmasi_password"
              placeholder="Ulangi password baru"
              autocomplete="new-password"
              required
            >

            <button
              type="button"
              onclick="togglePassword('passwordResetConfirm', this)"
            >

              <i data-lucide="eye"></i>

            </button>

          </div>

        </div>


        <!-- FOOTER -->

        <div class="setting-modal-footer">

          <button
            type="button"
            class="setting-secondary-button"
            onclick="tutupModalResetPassword()"
          >

            Batal

          </button>

          <button
            type="submit"
            class="setting-primary-button"
          >

            <i data-lucide="key-round"></i>

            Reset Password

          </button>

        </div>


      </form>

    </div>

  </div>


  <!-- ==================================================
       JAVASCRIPT
  ================================================== -->

  <script>

    // ==================================================
    // LUCIDE
    // ==================================================

    document.addEventListener('DOMContentLoaded', function () {

      lucide.createIcons();

    });


    // ==================================================
    // MODAL TAMBAH
    // ==================================================

    function bukaModalTambah() {

      const modal =
        document.getElementById('modalTambahAdmin');

      modal.classList.add('show');

      document.body.classList.add('modal-open');

    }


    function tutupModalTambah() {

      const modal =
        document.getElementById('modalTambahAdmin');

      modal.classList.remove('show');

      document.body.classList.remove('modal-open');

      const form =
        document.getElementById('formTambahAdmin');

      if (form) {
        form.reset();
      }

    }


    // ==================================================
    // MODAL EDIT
    // ==================================================

    function bukaModalEdit(button) {

      const id =
        button.dataset.id;

      const nama =
        button.dataset.nama || '';

      const username =
        button.dataset.username || '';

      const nomorWa =
        button.dataset.nomorwa || '';


      document.getElementById(
        'editNamaAdmin'
      ).value = nama;


      document.getElementById(
        'editUsername'
      ).value = username;


      document.getElementById(
        'editNomorWa'
      ).value = nomorWa;


      document.getElementById(
        'formEditAdmin'
      ).action =
        '/setting/admin/edit/' + id;


      const modal =
        document.getElementById('modalEditAdmin');

      modal.classList.add('show');

      document.body.classList.add('modal-open');

    }


    function tutupModalEdit() {

      const modal =
        document.getElementById('modalEditAdmin');

      modal.classList.remove('show');

      document.body.classList.remove('modal-open');

    }


    // ==================================================
    // MODAL RESET PASSWORD
    // ==================================================

    function bukaModalResetPassword(button) {

      const id =
        button.dataset.id;

      const nama =
        button.dataset.nama || 'admin';


      document.getElementById(
        'resetPasswordDescription'
      ).textContent =
        'Buat password baru untuk ' + nama + '.';


      document.getElementById(
        'formResetPassword'
      ).action =
        '/setting/admin/reset-password/' + id;


      document.getElementById(
        'passwordReset'
      ).value = '';


      document.getElementById(
        'passwordResetConfirm'
      ).value = '';


      const modal =
        document.getElementById('modalResetPassword');

      modal.classList.add('show');

      document.body.classList.add('modal-open');

    }


    function tutupModalResetPassword() {

      const modal =
        document.getElementById('modalResetPassword');

      modal.classList.remove('show');

      document.body.classList.remove('modal-open');

    }


    // ==================================================
    // TOGGLE PASSWORD
    // ==================================================

    function togglePassword(inputId, button) {

      const input =
        document.getElementById(inputId);

      if (!input) {
        return;
      }


      if (input.type === 'password') {

        input.type = 'text';

        button.innerHTML =
          '<i data-lucide="eye-off"></i>';

      } else {

        input.type = 'password';

        button.innerHTML =
          '<i data-lucide="eye"></i>';

      }


      lucide.createIcons();

    }


    // ==================================================
    // SUBMIT TAMBAH ADMIN
    // ==================================================

    document
      .getElementById('formTambahAdmin')
      .addEventListener('submit', async function (event) {

        event.preventDefault();

        const form = this;

        const submitButton =
          form.querySelector('button[type="submit"]');

        const originalButtonHTML =
          submitButton.innerHTML;


        // ==================================================
        // PERUBAHAN PENTING:
        // FormData -> URLSearchParams
        // ==================================================

        const data =
          new URLSearchParams(
            new FormData(form)
          );


        const password =
          data.get('password');


        // ==================================================
        // VALIDASI PASSWORD
        // ==================================================

        if (!password || password.length < 6) {

          Swal.fire({

            icon: 'warning',

            title: 'Password Terlalu Pendek',

            text: 'Password minimal 6 karakter.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });

          return;

        }


        // ==================================================
        // LOADING BUTTON
        // ==================================================

        submitButton.disabled = true;

        submitButton.innerHTML = `
          <i data-lucide="loader-circle"></i>
          Menambahkan...
        `;

        lucide.createIcons();


        try {

          const response =
            await fetch(
              form.action,
              {
                method: 'POST',

                body: data,

                headers: {
                  'Content-Type':
                    'application/x-www-form-urlencoded;charset=UTF-8',

                  'Accept':
                    'application/json'
                }
              }
            );


          // ==================================================
          // CEK RESPONSE SERVER
          // ==================================================

          const contentType =
            response.headers.get('content-type') || '';


          if (!contentType.includes('application/json')) {

            console.error(
              'Response bukan JSON:',
              await response.text()
            );

            throw new Error(
              'Server tidak mengembalikan response JSON.'
            );

          }


          const result =
            await response.json();


          // ==================================================
          // BERHASIL
          // ==================================================

          if (response.ok && result.success) {

            // Tutup modal TERLEBIH DAHULU
            tutupModalTambah();


            // Tampilkan SweetAlert setelah modal ditutup
            await Swal.fire({

              icon: 'success',

              title: 'Berhasil',

              text:
                result.message ||
                'Admin berhasil ditambahkan.',

              confirmButtonText: 'OK',

              confirmButtonColor: '#2563eb'

            });


            // Refresh halaman setelah SweetAlert ditutup
            window.location.reload();


            return;

          }


          // ==================================================
          // GAGAL DARI SERVER
          // ==================================================

          Swal.fire({

            icon: 'error',

            title: 'Gagal',

            text:
              result.message ||
              'Gagal menambahkan admin.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });


        } catch (error) {

          console.error(
            'Error tambah admin:',
            error
          );


          Swal.fire({

            icon: 'error',

            title: 'Terjadi Kesalahan',

            text:
              'Tidak dapat memproses penambahan admin. Silakan coba lagi.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });


        } finally {

          // ==================================================
          // KEMBALIKAN TOMBOL
          // ==================================================

          submitButton.disabled = false;

          submitButton.innerHTML =
            originalButtonHTML;

          lucide.createIcons();

        }

      });


    // ==================================================
    // SUBMIT EDIT ADMIN
    // ==================================================

    document
      .getElementById('formEditAdmin')
      .addEventListener('submit', async function (event) {

        event.preventDefault();


        const form = this;


        // ==================================================
        // PERUBAHAN PENTING:
        // FormData -> URLSearchParams
        // ==================================================

        const data =
          new URLSearchParams(
            new FormData(form)
          );


        try {

          const response =
            await fetch(
              form.action,
              {
                method: 'POST',

                body: data,

                headers: {
                  'Content-Type':
                    'application/x-www-form-urlencoded;charset=UTF-8',

                  'Accept':
                    'application/json'
                }
              }
            );


          const result =
            await response.json();


          if (result.success) {

            tutupModalEdit();


            await Swal.fire({

              icon: 'success',

              title: 'Berhasil',

              text:
                result.message ||
                'Data admin berhasil diperbarui.',

              confirmButtonText: 'OK',

              confirmButtonColor: '#2563eb'

            });


            window.location.reload();

          } else {

            Swal.fire({

              icon: 'error',

              title: 'Gagal',

              text:
                result.message ||
                'Gagal memperbarui data admin.',

              confirmButtonText: 'OK',

              confirmButtonColor: '#2563eb'

            });

          }


        } catch (error) {

          console.error(error);

          Swal.fire({

            icon: 'error',

            title: 'Terjadi Kesalahan',

            text:
              'Tidak dapat terhubung ke server.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });

        }

      });


    // ==================================================
    // SUBMIT RESET PASSWORD
    // ==================================================

    document
      .getElementById('formResetPassword')
      .addEventListener('submit', async function (event) {

        event.preventDefault();


        const form = this;


        // ==================================================
        // PERUBAHAN PENTING:
        // FormData -> URLSearchParams
        // ==================================================

        const data =
          new URLSearchParams(
            new FormData(form)
          );


        const passwordBaru =
          data.get('password_baru');


        const konfirmasi =
          data.get('konfirmasi_password');


        if (!passwordBaru || passwordBaru.length < 6) {

          Swal.fire({

            icon: 'warning',

            title: 'Password Terlalu Pendek',

            text:
              'Password minimal 6 karakter.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });

          return;

        }


        if (passwordBaru !== konfirmasi) {

          Swal.fire({

            icon: 'warning',

            title: 'Password Tidak Sama',

            text:
              'Konfirmasi password tidak sesuai.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });

          return;

        }


        try {

          const response =
            await fetch(
              form.action,
              {
                method: 'POST',

                body: data,

                headers: {
                  'Content-Type':
                    'application/x-www-form-urlencoded;charset=UTF-8',

                  'Accept':
                    'application/json'
                }
              }
            );


          const result =
            await response.json();


          if (result.success) {

            tutupModalResetPassword();


            await Swal.fire({

              icon: 'success',

              title: 'Berhasil',

              text:
                result.message ||
                'Password admin berhasil diubah.',

              confirmButtonText: 'OK',

              confirmButtonColor: '#2563eb'

            });


            window.location.reload();

          } else {

            Swal.fire({

              icon: 'error',

              title: 'Gagal',

              text:
                result.message ||
                'Gagal mengubah password admin.',

              confirmButtonText: 'OK',

              confirmButtonColor: '#2563eb'

            });

          }


        } catch (error) {

          console.error(error);

          Swal.fire({

            icon: 'error',

            title: 'Terjadi Kesalahan',

            text:
              'Tidak dapat terhubung ke server.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });

        }

      });


    // ==================================================
    // HAPUS ADMIN
    // ==================================================

    async function hapusAdmin(button) {

      const id =
        button.dataset.id;

      const nama =
        button.dataset.nama || 'admin';


      const konfirmasi =
        await Swal.fire({

          icon: 'warning',

          title: 'Hapus Admin?',

          html:
            'Apakah kamu yakin ingin menghapus akun admin ' +
            '<strong>' + nama + '</strong>?' +
            '<br><br>' +
            '<small>Tindakan ini tidak dapat dibatalkan.</small>',

          showCancelButton: true,

          confirmButtonText: 'Ya, Hapus',

          cancelButtonText: 'Batal',

          confirmButtonColor: '#dc2626',

          cancelButtonColor: '#6b7280'

        });


      if (!konfirmasi.isConfirmed) {

        return;

      }


      try {

        const response =
          await fetch(
            '/setting/admin/hapus/' + id,
            {
              method: 'POST',

              headers: {
                'Accept':
                  'application/json'
              }
            }
          );


        const result =
          await response.json();


        if (result.success) {

          await Swal.fire({

            icon: 'success',

            title: 'Berhasil',

            text:
              result.message ||
              'Admin berhasil dihapus.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });


          window.location.reload();

        } else {

          Swal.fire({

            icon: 'error',

            title: 'Gagal',

            text:
              result.message ||
              'Gagal menghapus admin.',

            confirmButtonText: 'OK',

            confirmButtonColor: '#2563eb'

          });

        }


      } catch (error) {

        console.error(error);

        Swal.fire({

          icon: 'error',

          title: 'Terjadi Kesalahan',

          text:
            'Tidak dapat terhubung ke server.',

          confirmButtonText: 'OK',

          confirmButtonColor: '#2563eb'

        });

      }

    }


    // ==================================================
    // ESC UNTUK MENUTUP MODAL
    // ==================================================

    document.addEventListener('keydown', function (event) {

      if (event.key !== 'Escape') {
        return;
      }


      tutupModalTambah();

      tutupModalEdit();

      tutupModalResetPassword();

    });

  </script>


